@inherits Dynamicweb.Rendering.ViewModelTemplate<Dynamicweb.Frontend.ParagraphViewModel>
@using Dynamicweb.Frontend



@{
	string cmd = "";
	int i = 4;
	int totalPages = 0;
	//var usernameGlobal = GetGlobalValue("Global:Extranet.UserName");

}
<style>
	.currenttotal0{
		color: red;
	}
	.currenttotal1{
		color: yellow;
	}
	.currenttotal2{
		color: green;
	}
	.currenttotal3{
		color: blue;
	}
</style>
<h1></h1>
@TemplateTags()
@switch(totalPages){
	case 1:
		@:<div id="items-pages" class="items-pages currenttotal@(totalPages) mblpagination">@totalPages</div>
		break;
	case 2:
		@:<div id="items-pages" class="items-pages currenttotal@(totalPages) mblpagination">@totalPages</div>
		break;
	case 3:
		@:<div id="items-pages" class="items-pages currenttotal@(totalPages) mblpagination">@totalPages</div>
		break;
	default:
		@:<div id="items-pages" class="items-pages currenttotal0 mblpagination">defaultt</div>
		break;
}
<div id="items-pages" class="items-pages currenttotal@(i) mblpagination">&nbsp;&nbsp;items in list</div>
<div>
	<div data-swift-text class="mb-0-last-child">
		@if (Model.Item.TryGetString("Title", out string title)) {
			@title
		}
		@if (Model.Item.TryGetString("Subtitle", out string subtitle)) {
			@subtitle
		}
		@if (Model.Item.TryGetString("Text", out string text)) {
			@text
		}
	</div>
	<div class="d-flex flex-wrap gap-2 align-items-center">
		@if (Model.Item.TryGetButton("FirstButton", out ButtonViewModel firstButton)) {
			<a href="@firstButton.Link.Url" class="btn btn-@firstButton.Style" data-dw-button="@firstButton.Style">@firstButton.Label</a>
		}
		@if (Model.Item.TryGetButton("SecondButton", out ButtonViewModel secondButton)) {
			<a href="@secondButton.Link.Url" class="btn btn-@secondButton.Style" data-dw-button="@secondButton.Style">@secondButton.Label</a>
		}
	</div>
</div>
